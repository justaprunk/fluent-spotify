<Page
    x:Class="FluentSpotify.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:FluentSpotify.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:spotify="using:SpotifyAPI.Web"
    xmlns:vm="using:FluentSpotify.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Карточка плейлиста в сетке медиатеки -->
        <DataTemplate x:Key="PlaylistCardTemplate" x:DataType="spotify:FullPlaylist">
            <Border Width="160" Height="210" Padding="12" Margin="0,0,12,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="8">
                    <Border Width="136" Height="136" CornerRadius="6">
                        <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xEC4F;" FontSize="32"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{x:Bind Images, Converter={StaticResource UrlToImageSourceConverter}}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{x:Bind Owner.DisplayName}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Background="Transparent" Padding="24,16,24,24">
        <StackPanel Spacing="24">
            <!-- Заголовок секции -->
            <TextBlock Text="{l:Tr Key=Nav_Home}" FontSize="26" FontWeight="Bold" />

            <!-- Быстрый доступ: карточка «Любимые треки» в стиле плиток Windows 11 -->
            <Button HorizontalAlignment="Left" MinWidth="360" MaxWidth="480"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Padding="8,8,16,8" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    AutomationProperties.Name="{l:Tr Key=Nav_Liked}"
                    Click="OnLikedSongsClick">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Обложка коллекции: квадратная плитка с мягким градиентом акцентного цвета -->
                    <Border Width="48" Height="48" CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{ThemeResource SystemAccentColorDark1}" Offset="0" />
                                <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xEB52;" FontSize="20" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{l:Tr Key=Nav_Liked}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.LikedTracksText, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>

            <!-- Сетка медиатеки плейлистов: один раздел или по разделу на каждую папку -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.HomeSections, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistSection">
                        <StackPanel Spacing="12">
                            <!-- Путь папки и число плейлистов; длинный путь переносится на узком окне -->
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" />
                                <Run Text="{x:Bind Subtitle}" FontSize="12"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </TextBlock>

                            <GridView ItemsSource="{x:Bind Playlists}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="OnPlaylistItemClick"
                                      ItemTemplate="{StaticResource PlaylistCardTemplate}">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- Без ограничения числа колонок: сетка заполняет всю ширину широкого окна -->
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                            </GridView>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

    </ScrollViewer>
</Page>