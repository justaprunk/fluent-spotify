<Page
    x:Class="FluentSpotify.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentSpotify.Controls"
    xmlns:l="using:FluentSpotify.Localization"
    xmlns:vm="using:FluentSpotify.ViewModels">

    <ScrollViewer Background="Transparent" Padding="24,16,24,24"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- Карточки тянутся на всю ширину, на широком окне — не шире 1100 px и по центру.
             Grid нужен для центрирования: прямо в ScrollViewer ограниченный по ширине блок уезжает вправо. -->
        <Grid>
        <StackPanel MaxWidth="1100" Spacing="4">
            <TextBlock Text="{l:Tr Key=Settings_Title}" FontSize="26" FontWeight="Bold" Margin="0,0,0,4" />

            <!-- Оформление -->
            <TextBlock Text="{l:Tr Key=Settings_SectionAppearance}" Style="{StaticResource SettingsSectionHeaderStyle}" Margin="1,12,0,6" />

            <controls:SettingsCard Glyph="&#xF2B7;"
                                   Header="{l:Tr Key=Settings_Language}"
                                   Description="{l:Tr Key=Settings_LanguageDesc}">
                <ComboBox MinWidth="200"
                          ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                          DisplayMemberPath="Title" />
            </controls:SettingsCard>

            <InfoBar IsOpen="{x:Bind ViewModel.IsRestartRequired, Mode=OneWay}" IsClosable="False" Severity="Informational"
                     Title="{x:Bind ViewModel.RestartTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.RestartMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="{x:Bind ViewModel.RestartButtonText, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.RestartCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <controls:SettingsCard Glyph="&#xE771;"
                                   Header="{l:Tr Key=Settings_ShellTheme}"
                                   Description="{l:Tr Key=Settings_ShellThemeDesc}">
                <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                              IsOn="{x:Bind ViewModel.UseShellTheme, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE7F4;"
                                   Header="{l:Tr Key=Settings_Backdrop}"
                                   Description="{x:Bind ViewModel.SelectedBackdrop.Description, Mode=OneWay}">
                <ComboBox MinWidth="200"
                          IsEnabled="{x:Bind ViewModel.IsOwnThemeEnabled, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.BackdropOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedBackdrop, Mode=TwoWay}"
                          DisplayMemberPath="Title" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE790;"
                                   Header="{l:Tr Key=Settings_Theme}"
                                   Description="{l:Tr Key=Settings_ThemeDesc}">
                <ComboBox MinWidth="200"
                          IsEnabled="{x:Bind ViewModel.IsOwnThemeEnabled, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                          DisplayMemberPath="Title" />
            </controls:SettingsCard>

            <InfoBar IsOpen="{x:Bind ViewModel.HasSupportNote}" IsClosable="False" Severity="Informational"
                     Message="{x:Bind ViewModel.SupportNote}" />

            <!-- Воспроизведение -->
            <TextBlock Text="{l:Tr Key=Settings_SectionPlayback}" Style="{StaticResource SettingsSectionHeaderStyle}" />

            <controls:SettingsCard Glyph="&#xE7F5;" Header="{l:Tr Key=Settings_Background}">
                <controls:SettingsCard.Description>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:Tr Key=Settings_BackgroundDesc}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ClientStatusText}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </controls:SettingsCard.Description>
                <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                              IsOn="{x:Bind ViewModel.LaunchClientInBackground, Mode=TwoWay}" />
            </controls:SettingsCard>

            <InfoBar IsOpen="{x:Bind ViewModel.IsClientMissing}" IsClosable="False" Severity="Warning"
                     Title="{l:Tr Key=Settings_ClientMissingTitle}"
                     Message="{l:Tr Key=Settings_ClientMissingMessage}" />

            <!-- Панель «Сейчас играет»: сторонние источники можно отключить -->
            <TextBlock Text="{l:Tr Key=Settings_SectionNowPlaying}" Style="{StaticResource SettingsSectionHeaderStyle}" />

            <controls:SettingsCard Glyph="&#xE8D2;"
                                   Header="{l:Tr Key=Settings_Lyrics}"
                                   Description="{l:Tr Key=Settings_LyricsDesc}">
                <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                              IsOn="{x:Bind ViewModel.ShowLyrics, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE77B;"
                                   Header="{l:Tr Key=Settings_ArtistBio}"
                                   Description="{l:Tr Key=Settings_ArtistBioDesc}">
                <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                              IsOn="{x:Bind ViewModel.ShowArtistBio, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!-- Медиатека: локальные папки плейлистов -->
            <TextBlock Text="{l:Tr Key=Settings_SectionLibrary}" Style="{StaticResource SettingsSectionHeaderStyle}" />

            <controls:SettingsCard Glyph="&#xF0E2;"
                                   Header="{l:Tr Key=Settings_GroupHome}"
                                   Description="{l:Tr Key=Settings_GroupHomeDesc}">
                <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                              IsOn="{x:Bind ViewModel.GroupHomeByFolders, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE8B7;"
                                   Header="{l:Tr Key=Settings_Folders}"
                                   Description="{l:Tr Key=Settings_FoldersDesc}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:Tr Key=Settings_Export}" MinWidth="100" Click="OnExportFoldersClick" />
                    <Button Content="{l:Tr Key=Settings_Import}" MinWidth="100" Click="OnImportFoldersClick" />
                </StackPanel>
            </controls:SettingsCard>

            <InfoBar IsOpen="{x:Bind ViewModel.IsFoldersStatusOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.FoldersStatusSeverity, Mode=OneWay}"
                     Message="{x:Bind ViewModel.FoldersStatus, Mode=OneWay}" />

            <!-- Аккаунт -->
            <TextBlock Text="{l:Tr Key=Settings_SectionAccount}" Style="{StaticResource SettingsSectionHeaderStyle}" />

            <controls:SettingsCard Glyph="&#xE8D7;"
                                   Header="{l:Tr Key=Settings_ClientId}"
                                   Description="{l:Tr Key=Settings_ClientIdDesc}">
                <Button Content="{l:Tr Key=Settings_Change}" MinWidth="120"
                        Command="{x:Bind ViewModel.ChangeClientIdCommand}" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xF3B1;"
                                   Header="{l:Tr Key=Settings_SignOutTitle}"
                                   Description="{l:Tr Key=Settings_SignOutDesc}">
                <Button Content="{l:Tr Key=Settings_SignOut}" MinWidth="120"
                        Command="{x:Bind ViewModel.LogoutCommand}" />
            </controls:SettingsCard>

            <!-- О приложении: версия и обновления в одном месте -->
            <TextBlock Text="{l:Tr Key=Settings_SectionAbout}" Style="{StaticResource SettingsSectionHeaderStyle}" />

            <controls:SettingsCard Image="ms-appx:///Assets/AppIcon.png" Header="Fluent Spotify">
                <controls:SettingsCard.Description>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Updates.VersionSummaryText, Mode=OneWay}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.Updates.StatusText, Mode=OneWay}" IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </controls:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing IsActive="{x:Bind ViewModel.Updates.IsChecking, Mode=OneWay}" Width="20" Height="20"
                                  Visibility="{x:Bind ViewModel.Updates.IsChecking, Mode=OneWay}" />
                    <Button Content="{l:Tr Key=Update_CheckButton}" MinWidth="120"
                            IsEnabled="{x:Bind ViewModel.Updates.CanCheck, Mode=OneWay}"
                            Command="{x:Bind ViewModel.Updates.CheckCommand}" />
                </StackPanel>
            </controls:SettingsCard>

            <!-- Найденная версия: описание изменений из релиза на GitHub -->
            <Expander x:Name="UpdatesExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      IsExpanded="{x:Bind ViewModel.Updates.IsDetailsExpanded, Mode=TwoWay}"
                      Visibility="{x:Bind ViewModel.Updates.IsUpdateAvailable, Mode=OneWay}">
                <Expander.Header>
                    <controls:SettingsCard Glyph="&#xE896;" Background="Transparent" BorderThickness="0" Padding="0,8"
                                           Header="{x:Bind ViewModel.Updates.AvailableTitle, Mode=OneWay}"
                                           Description="{x:Bind ViewModel.Updates.AvailableDetails, Mode=OneWay}">
                        <Button Content="{l:Tr Key=Update_Install}" MinWidth="120"
                                Style="{ThemeResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.Updates.CanInstall, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Updates.InstallCommand}" />
                    </controls:SettingsCard>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Text="{l:Tr Key=Update_WhatsNew}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.Updates.ReleaseNotes, Mode=OneWay}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <ProgressBar Value="{x:Bind ViewModel.Updates.DownloadProgress, Mode=OneWay}" Maximum="100"
                                 Visibility="{x:Bind ViewModel.Updates.IsInstalling, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:Tr Key=Update_Skip}"
                                IsEnabled="{x:Bind ViewModel.Updates.CanSkip, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Updates.SkipCommand}" />
                        <HyperlinkButton Content="{l:Tr Key=Update_OpenGitHub}"
                                         Command="{x:Bind ViewModel.Updates.OpenReleasePageCommand}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <controls:SettingsCard Glyph="&#xE9D5;"
                                   Header="{l:Tr Key=Settings_Beta}"
                                   Description="{l:Tr Key=Settings_BetaDesc}">
                <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                              IsOn="{x:Bind ViewModel.Updates.IncludePrereleases, Mode=TwoWay}" />
            </controls:SettingsCard>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
