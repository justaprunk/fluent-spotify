<Page
    x:Class="FluentSpotify.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FluentSpotify.ViewModels">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer Background="Transparent" Padding="24,16,24,24"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- Как в параметрах Windows: контент прижат влево и не шире 1000 px -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="Настройки" FontSize="26" FontWeight="Bold" Margin="0,0,0,12" />

            <!-- Оформление -->
            <TextBlock Text="Оформление" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE771;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Использовать тему оболочки WSHM" TextWrapping="Wrap" />
                        <TextBlock Text="Материал и тема берутся из ~/.config/wshm/theme.json и меняются вместе с оболочкой"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                                  IsOn="{x:Bind ViewModel.UseShellTheme, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7F4;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Материал окна (System Backdrop)" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedBackdrop.Description, Mode=OneWay}"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" MinWidth="160" VerticalAlignment="Center"
                              IsEnabled="{x:Bind ViewModel.IsOwnThemeEnabled, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.BackdropOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedBackdrop, Mode=TwoWay}"
                              DisplayMemberPath="Title" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Тема приложения" TextWrapping="Wrap" />
                        <TextBlock Text="Светлая, тёмная или как в настройках Windows"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" MinWidth="160" VerticalAlignment="Center"
                              IsEnabled="{x:Bind ViewModel.IsOwnThemeEnabled, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                              DisplayMemberPath="Title" />
                </Grid>
            </Border>

            <InfoBar IsOpen="{x:Bind ViewModel.HasSupportNote}" IsClosable="False" Severity="Informational"
                     Message="{x:Bind ViewModel.SupportNote}" />

            <!-- Воспроизведение -->
            <TextBlock Text="Воспроизведение" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,4" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7F5;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Запускать Spotify в фоне автоматически" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Звук воспроизводит официальный клиент Spotify. Он будет запускаться скрытым, а воспроизведение — переноситься на этот компьютер, если сейчас ничего не играет. Если открыть Spotify из меню «Пуск», его окно появится как обычно." />
                        <TextBlock Text="{x:Bind ViewModel.ClientStatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                                  IsOn="{x:Bind ViewModel.LaunchClientInBackground, Mode=TwoWay}" />
                </Grid>
            </Border>

            <InfoBar IsOpen="{x:Bind ViewModel.IsClientMissing}" IsClosable="False" Severity="Warning"
                     Title="Клиент Spotify не установлен"
                     Message="Без него воспроизводить музыку на этом компьютере нельзя — можно управлять только другими устройствами (телефон, другой ПК)." />

            <!-- Аккаунт -->
            <TextBlock Text="Аккаунт" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,4" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D7;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Spotify Client ID" TextWrapping="Wrap" />
                        <TextBlock Text="Выход из аккаунта и ввод другого Client ID из Spotify Developer Dashboard"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Изменить" VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ChangeClientIdCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xF3B1;" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Выйти из аккаунта Spotify" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Content="Выйти" VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.LogoutCommand}" />
                </Grid>
            </Border>

            <!-- Обновления -->
            <TextBlock Text="Обновления" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,4" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE895;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Updates.CurrentVersionText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Updates.LastCheckText, Mode=OneWay}"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Updates.StatusText, Mode=OneWay}" IsTextSelectionEnabled="True"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing IsActive="{x:Bind ViewModel.Updates.IsChecking, Mode=OneWay}" Width="20" Height="20" />
                        <Button Content="Проверить обновления"
                                IsEnabled="{x:Bind ViewModel.Updates.CanCheck, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Updates.CheckCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D5;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Получать бета-версии" TextWrapping="Wrap" />
                        <TextBlock Text="Предлагать пре-релизы: новые функции раньше, но возможны ошибки"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                                  IsOn="{x:Bind ViewModel.Updates.IncludePrereleases, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Найденная версия: описание изменений из релиза на GitHub -->
            <Expander x:Name="UpdatesExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      IsExpanded="{x:Bind ViewModel.Updates.IsDetailsExpanded, Mode=TwoWay}"
                      Visibility="{x:Bind ViewModel.Updates.IsUpdateAvailable, Mode=OneWay}">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE896;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Updates.AvailableTitle, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Updates.AvailableDetails, Mode=OneWay}"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Обновить" VerticalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.Updates.CanInstall, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Updates.InstallCommand}" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Text="Что нового" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.Updates.ReleaseNotes, Mode=OneWay}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <ProgressBar Value="{x:Bind ViewModel.Updates.DownloadProgress, Mode=OneWay}" Maximum="100"
                                 Visibility="{x:Bind ViewModel.Updates.IsInstalling, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Пропустить эту версию"
                                IsEnabled="{x:Bind ViewModel.Updates.CanSkip, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Updates.SkipCommand}" />
                        <HyperlinkButton Content="Открыть на GitHub"
                                         Command="{x:Bind ViewModel.Updates.OpenReleasePageCommand}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- О приложении -->
            <TextBlock Text="О приложении" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,4" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Fluent Spotify" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.AppVersionText}" IsTextSelectionEnabled="True"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
