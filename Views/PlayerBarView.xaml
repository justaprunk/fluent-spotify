<UserControl
    x:Class="FluentSpotify.Views.PlayerBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:FluentSpotify.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FluentSpotify.ViewModels"
    mc:Ignorable="d">

    <Grid Background="Transparent" Height="96" Padding="16,6,16,10">
        <!-- Адаптивная вёрстка: на узком окне прячем второстепенные элементы -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="680" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VolumeSlider.Width" Value="72" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VolumePanel.Visibility" Value="Collapsed" />
                        <Setter Target="ShuffleButton.Visibility" Value="Collapsed" />
                        <Setter Target="RepeatButton.Visibility" Value="Collapsed" />
                        <Setter Target="PositionText.Visibility" Value="Collapsed" />
                        <Setter Target="DurationText.Visibility" Value="Collapsed" />
                        <!-- Остаётся только кнопка панели «Сейчас играет» -->
                        <Setter Target="RightColumn.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,6">
            <Grid VerticalAlignment="Center" ColumnSpacing="16">
                <!-- Боковые колонки тянутся на всю оставшуюся ширину и равны между собой,
                     поэтому центральная секция всегда ровно по центру окна.
                     Ограничена только центральная колонка — иначе на широком окне
                     справа оставалась пустота, а громкость «висела» посередине. -->
                <Grid.ColumnDefinitions>
                    <!-- Левая секция: метаданные трека -->
                    <ColumnDefinition Width="*" />
                    <!-- Центральная секция: органы управления и таймлайн -->
                    <ColumnDefinition Width="2*" MinWidth="200" MaxWidth="640" />
                    <!-- Правая секция: громкость -->
                    <ColumnDefinition x:Name="RightColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Метаданные текущей композиции (сама секция не шире 360 px и прижата влево) -->
                <Grid Grid.Column="0" ColumnSpacing="12" VerticalAlignment="Center"
                      HorizontalAlignment="Left" MaxWidth="360">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6">
                        <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xEC4F;" FontSize="20"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{x:Bind ViewModel.AlbumArtUrl, Mode=OneWay, Converter={StaticResource UrlToImageSourceConverter}}"
                                   Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <TextBlock Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </StackPanel>
                </Grid>

                <!-- 2. Органы управления воспроизведением и таймлайн.
                     Stretch (а не Center), иначе колонка сжимается до ширины кнопок и слайдер перемотки исчезает. -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <ToggleButton x:Name="ShuffleButton"
                                      Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                                      IsChecked="{x:Bind ViewModel.IsShuffle, Mode=OneWay}"
                                      Width="32" Height="32" Padding="0" CornerRadius="16"
                                      Background="Transparent" BorderThickness="0"
                                      ToolTipService.ToolTip="{l:Tr Key=Player_Shuffle}" AutomationProperties.Name="{l:Tr Key=Player_Shuffle}">
                            <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                        </ToggleButton>

                        <Button Command="{x:Bind ViewModel.PreviousTrackCommand}"
                                Width="32" Height="32" Padding="0" CornerRadius="16"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="{l:Tr Key=Player_Previous}" AutomationProperties.Name="{l:Tr Key=Player_Previous}">
                            <FontIcon Glyph="&#xE892;" FontSize="14" />
                        </Button>

                        <Button Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                                Width="38" Height="38" Padding="0"
                                CornerRadius="19"
                                Style="{ThemeResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{l:Tr Key=Player_PlayPause}" AutomationProperties.Name="{l:Tr Key=Player_PlayPause}">
                            <FontIcon Glyph="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseIconConverter}}"
                                      FontSize="16" />
                        </Button>

                        <Button Command="{x:Bind ViewModel.NextTrackCommand}"
                                Width="32" Height="32" Padding="0" CornerRadius="16"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="{l:Tr Key=Player_Next}" AutomationProperties.Name="{l:Tr Key=Player_Next}">
                            <FontIcon Glyph="&#xE893;" FontSize="14" />
                        </Button>

                        <ToggleButton x:Name="RepeatButton"
                                      Command="{x:Bind ViewModel.ToggleRepeatCommand}"
                                      IsChecked="{x:Bind ViewModel.IsRepeat, Mode=OneWay}"
                                      Width="32" Height="32" Padding="0" CornerRadius="16"
                                      Background="Transparent" BorderThickness="0"
                                      ToolTipService.ToolTip="{l:Tr Key=Player_Repeat}" AutomationProperties.Name="{l:Tr Key=Player_Repeat}">
                            <FontIcon Glyph="&#xE8EE;" FontSize="14" />
                        </ToggleButton>
                    </StackPanel>

                    <!-- Прогресс-бар (Seek Slider) -->
                    <Grid ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PositionText" Grid.Column="0" Text="{x:Bind ViewModel.PositionText, Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" MinWidth="32" TextAlignment="Right" />

                        <Slider x:Name="SeekSlider"
                                Grid.Column="1"
                                IsThumbToolTipEnabled="False"
                                Minimum="0"
                                Maximum="{x:Bind ViewModel.DurationMs, Mode=OneWay}"
                                Value="{x:Bind ViewModel.CurrentPositionMs, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="0,-4,0,-8"
                                AutomationProperties.Name="{l:Tr Key=Player_Position}" />

                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" MinWidth="32" />
                    </Grid>
                </StackPanel>

                <!-- 3. Панель «Сейчас играет» и громкость -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                    <ToggleButton IsChecked="{x:Bind ViewModel.NowPlaying.IsPaneOpen, Mode=TwoWay}"
                                  Width="32" Height="32" Padding="0" CornerRadius="16"
                                  Background="Transparent" BorderThickness="0"
                                  ToolTipService.ToolTip="{l:Tr Key=NowPlaying_Toggle}"
                                  AutomationProperties.Name="{l:Tr Key=NowPlaying_Toggle}">
                        <FontIcon Glyph="&#xE90B;" FontSize="14" />
                    </ToggleButton>

                    <StackPanel x:Name="VolumePanel" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="VolumeSlider"
                                Width="110"
                                Minimum="0"
                                Maximum="100"
                                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{l:Tr Key=Player_Volume}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
