<Page
    x:Class="FluentSpotify.Views.PlaylistDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FluentSpotify.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Background="Transparent" Padding="24,16,24,24">
        <StackPanel Spacing="20">
            <!-- Шапка плейлиста -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="160" Height="160" CornerRadius="8">
                    <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xEC4F;" FontSize="40" 
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{x:Bind ViewModel.CoverUrl, Mode=OneWay, Converter={StaticResource UrlToImageSourceConverter}}" Stretch="UniformToFill" />
                        <!-- Обложка «Любимых треков» -->
                        <Grid Visibility="{x:Bind ViewModel.IsLikedSongs, Mode=OneWay}">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{ThemeResource SystemAccentColorDark1}" Offset="0" />
                                    <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="1" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <FontIcon Glyph="&#xEB52;" FontSize="56" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                    <TextBlock Text="{x:Bind ViewModel.KindLabel, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                    
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <TextBlock Text="{x:Bind ViewModel.OwnerName, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalTracksText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Панель действий -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Width="48" Height="48" CornerRadius="24"
                        Command="{x:Bind ViewModel.PlayPlaylistCommand}"
                        Style="{ThemeResource AccentButtonStyle}">
                    <FontIcon Glyph="&#xE768;" FontSize="18" />
                </Button>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="24" Height="24" VerticalAlignment="Center" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Warning"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <!-- Список композиций -->
            <ListView ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                      SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="OnTrackItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackDisplayItem">
                        <Grid Height="44" ColumnSpacing="12" Padding="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4">
                                <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Image Source="{x:Bind ImageUrl, Converter={StaticResource UrlToImageSourceConverter}}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" 
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Artist}" FontSize="11" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{x:Bind Album}" FontSize="12" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="3" Text="{x:Bind Duration}" FontSize="12" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>