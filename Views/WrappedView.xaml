<Page
    x:Class="FluentSpotify.Views.WrappedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FluentSpotify.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="WrappedCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScroll" Background="Transparent" Padding="24,16,24,24"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- Раскладка: Wide — карточки в ряд, треки и жанры рядом; Narrow — всё в одну колонку.
             Состояние выбирается по ширине страницы (SizeChanged), а не окна: панель навигации бывает разной ширины. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="HeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="HeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="HeaderActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeaderActions.Margin" Value="0,12,0,0" />

                        <Setter Target="HighlightCol1.Width" Value="0" />
                        <Setter Target="HighlightCol2.Width" Value="0" />
                        <Setter Target="HighlightsGrid.ColumnSpacing" Value="0" />
                        <Setter Target="HighlightsGrid.RowSpacing" Value="12" />
                        <Setter Target="TopArtistCard.(Grid.Row)" Value="1" />
                        <Setter Target="TopArtistCard.(Grid.Column)" Value="0" />
                        <Setter Target="TopGenreCard.(Grid.Row)" Value="2" />
                        <Setter Target="TopGenreCard.(Grid.Column)" Value="0" />

                        <Setter Target="GenresCol.Width" Value="0" />
                        <Setter Target="ListsGrid.ColumnSpacing" Value="0" />
                        <Setter Target="GenresPanel.(Grid.Row)" Value="1" />
                        <Setter Target="GenresPanel.(Grid.Column)" Value="0" />
                        <Setter Target="GenresPanel.Margin" Value="0,20,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Spacing="20">
            <!-- Заголовок и действия -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Мои итоги" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Что вы слушали чаще всего — по статистике Spotify"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <Button Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Обновить"
                            AutomationProperties.Name="Обновить">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.SavePlaylistCommand}"
                            Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Сохранить как плейлист" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Период статистики (time_range) -->
            <StackPanel Spacing="4">
                <SelectorBar x:Name="PeriodSelector" Margin="-12,0,0,0" />
                <ProgressBar IsIndeterminate="True"
                             Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                     IsClosable="False"
                     Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Войти заново" Command="{x:Bind ViewModel.ReloginCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.NeedsRelogin, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <StackPanel Spacing="28" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
                <!-- Карточки «№1 за период» -->
                <Grid x:Name="HighlightsGrid" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="HighlightCol1" Width="*" />
                        <ColumnDefinition x:Name="HighlightCol2" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource WrappedCardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="72" Height="72" CornerRadius="6">
                                <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xEC4F;" FontSize="24"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Image Source="{x:Bind ViewModel.TopTrackImageUrl, Mode=OneWay, Converter={StaticResource UrlToImageSourceConverter}}"
                                           Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="ТРЕК №1" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.TopTrackTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Text="{x:Bind ViewModel.TopTrackArtist, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="TopArtistCard" Grid.Column="1" Style="{StaticResource WrappedCardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="72" Height="72">
                                <Ellipse Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                <FontIcon Glyph="&#xE77B;" FontSize="24"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush Stretch="UniformToFill"
                                                    ImageSource="{x:Bind ViewModel.TopArtistImageUrl, Mode=OneWay, Converter={StaticResource UrlToImageSourceConverter}}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="АРТИСТ №1" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.TopArtistName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="TopGenreCard" Grid.Column="2" Style="{StaticResource WrappedCardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="72" Height="72" CornerRadius="6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{ThemeResource SystemAccentColorDark1}" Offset="0" />
                                        <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <FontIcon Glyph="&#xE8D6;" FontSize="28" Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="ЖАНР №1" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.TopGenreName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Text="{x:Bind ViewModel.TopGenreDetails, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Топ артистов: круглые фото, сетка без ограничения числа колонок -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Топ артистов" FontSize="18" FontWeight="SemiBold" />
                    <GridView ItemsSource="{x:Bind ViewModel.TopArtists, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="OnArtistItemClick">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RankedArtistItem">
                                <Border Width="148" Padding="12" Margin="0,0,12,12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        ToolTipService.ToolTip="{x:Bind Name}">
                                    <StackPanel Spacing="8">
                                        <Grid Width="112" Height="112" HorizontalAlignment="Center">
                                            <Ellipse Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                            <FontIcon Glyph="&#xE77B;" FontSize="32"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush Stretch="UniformToFill"
                                                                ImageSource="{x:Bind ImageUrl, Converter={StaticResource UrlToImageSourceConverter}}" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel Spacing="2">
                                            <TextBlock FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1">
                                                <Run Text="{x:Bind RankText}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><Run Text=". " Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><Run Text="{x:Bind Name}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind Genres}" FontSize="11" HorizontalAlignment="Center" Visibility="{x:Bind HasGenres}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- Топ треков и жанры: рядом на широком окне, друг под другом на узком -->
                <Grid x:Name="ListsGrid" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="GenresCol" Width="340" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Топ треков" FontSize="18" FontWeight="SemiBold" />
                        <ListView ItemsSource="{x:Bind ViewModel.TopTracks, Mode=OneWay}"
                                  SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="OnTrackItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RankedTrackItem">
                                    <Grid Height="52" ColumnSpacing="12" Padding="0,0,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind RankText}" FontSize="14" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="4">
                                            <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Image Source="{x:Bind ImageUrl, Converter={StaticResource UrlToImageSourceConverter}}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock Text="{x:Bind Artist}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{x:Bind Album}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />

                                        <TextBlock Grid.Column="4" Text="{x:Bind Duration}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel x:Name="GenresPanel" Grid.Column="1" Spacing="8">
                        <TextBlock Text="Топ жанров" FontSize="18" FontWeight="SemiBold" />
                        <Border Style="{StaticResource WrappedCardStyle}">
                            <Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.TopGenres, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.HasGenres, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="14" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GenreItem">
                                            <Grid ColumnSpacing="12" RowSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{x:Bind RankText}" FontWeight="SemiBold" FontSize="13"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                <ProgressBar Grid.Row="1" Grid.Column="1" Value="{x:Bind Share}" Maximum="100" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ArtistsText}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Поле genres у артистов Spotify устарело и может приходить пустым -->
                                <TextBlock Visibility="{x:Bind ViewModel.HasNoGenres, Mode=OneWay}"
                                           Text="Spotify не указал жанры для ваших артистов — без них топ жанров не собрать."
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
