<Application
    x:Class="FluentSpotify.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentSpotify"
    xmlns:controls="using:FluentSpotify.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Конвертеры для связывания состояния плеера и видимости в XAML -->
            <local:PlayPauseIconConverter x:Key="PlayPauseIconConverter" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <local:UrlToImageSourceConverter x:Key="UrlToImageSourceConverter" />

            <!-- Карточка параметра (Controls/SettingsCard.cs): значок, текст, элемент управления.
                 Одинаковая минимальная высота и выравнивание, как в «Параметрах» Windows 11. -->
            <Style TargetType="controls:SettingsCard">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:SettingsCard">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}"
                                    MinHeight="{TemplateBinding MinHeight}">
                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <FontIcon x:Name="PART_Icon" Glyph="{TemplateBinding Glyph}" FontSize="20"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="PART_Image" Source="{TemplateBinding Image}" Width="24" Height="24"
                                           VerticalAlignment="Center" Visibility="Collapsed" />

                                    <StackPanel x:Name="PART_Text" Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                                        <ContentPresenter x:Name="PART_Description" Content="{TemplateBinding Description}"
                                                          FontSize="12" TextWrapping="Wrap"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <ContentPresenter x:Name="PART_Content" Grid.Column="2"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Заголовок группы карточек на странице настроек -->
            <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,28,0,6" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Базовые радиусы скругления в стиле Windows 11 Fluent -->
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>