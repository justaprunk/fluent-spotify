<Application
    x:Class="FluentSpotify.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentSpotify">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Конвертеры для связывания состояния плеера и видимости в XAML -->
            <local:PlayPauseIconConverter x:Key="PlayPauseIconConverter" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <local:UrlToImageSourceConverter x:Key="UrlToImageSourceConverter" />

            <!-- Базовые радиусы скругления в стиле Windows 11 Fluent -->
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>