<win:FluentWindow
    x:Class="FluentSpotify.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:win="using:FluentSpotify.Shared.Windows"
    xmlns:views="using:FluentSpotify.Views"
    mc:Ignorable="d"
    Title="Fluent Spotify">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <!-- TitleBar Drag Area -->
            <RowDefinition Height="Auto" />
            <!-- Уведомление о новой версии -->
            <RowDefinition Height="Auto" />
            <!-- Основной контент: Навигация / Авторизация -->
            <RowDefinition Height="*" />
            <!-- Фиксированный нижний плеер-бар -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Сплошной фон, когда материал окна выключен или не поддерживается системой -->
        <Border x:Name="SolidBackground" Grid.RowSpan="4"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Visibility="Collapsed" />

        <!-- Кастомная область TitleBar для Drag-and-Drop перемещения окна -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="42" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" />
                <TextBlock Text="Spotify" FontWeight="SemiBold" FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- Доступна новая версия: обновление одной кнопкой, во время загрузки — прогресс -->
        <InfoBar Grid.Row="1" Margin="12,0,12,8"
                 Severity="{x:Bind Updates.InfoBarSeverity, Mode=OneWay}"
                 Title="{x:Bind Updates.AvailableTitle, Mode=OneWay}"
                 Message="{x:Bind Updates.InfoBarMessage, Mode=OneWay}"
                 IsOpen="{x:Bind Updates.IsInfoBarOpen, Mode=TwoWay}"
                 IsClosable="{x:Bind Updates.CanInstall, Mode=OneWay}">
            <InfoBar.Content>
                <StackPanel Spacing="8" Margin="0,0,0,12">
                    <ProgressBar Value="{x:Bind Updates.DownloadProgress, Mode=OneWay}" Maximum="100"
                                 Visibility="{x:Bind Updates.IsInstalling, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind Updates.CanInstall, Mode=OneWay}">
                        <Button Content="Обновить" Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind Updates.InstallCommand}" />
                        <Button Content="Подробнее" Command="{x:Bind Updates.ShowDetailsCommand}" />
                        <HyperlinkButton Content="Пропустить эту версию" Command="{x:Bind Updates.SkipCommand}" />
                    </StackPanel>
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- Экран 1: Пользователь не авторизован -->
        <Grid Grid.Row="2"
              Visibility="{x:Bind ViewModel.IsNotAuthenticated, Mode=OneWay}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16" MaxWidth="360" HorizontalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="96" Height="96" HorizontalAlignment="Center" />
                <TextBlock Text="Музыка для каждого момента" FontSize="20" FontWeight="Bold" TextAlignment="Center" />
                <TextBlock Text="Войдите через браузер для безопасного подключения вашей медиатеки Spotify по протоколу PKCE."
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <!-- Первичная настройка: Client ID приложения из Spotify Developer Dashboard -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsClientIdMissing, Mode=OneWay}">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="1. Создайте приложение на" />
                        <Hyperlink NavigateUri="https://developer.spotify.com/dashboard">developer.spotify.com/dashboard</Hyperlink>
                        <Run Text="(API: Web API)." />
                        <LineBreak />
                        <Run Text="2. В Redirect URIs добавьте:" />
                    </TextBlock>
                    <TextBox Text="{x:Bind ViewModel.RedirectUri}" IsReadOnly="True" FontSize="12" />
                    <TextBlock Text="3. Вставьте Client ID из настроек приложения:"
                               TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox Text="{x:Bind ViewModel.ClientIdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Client ID (32 символа)" FontSize="12" />
                    <Button Content="Сохранить Client ID"
                            Command="{x:Bind ViewModel.SaveClientIdCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>

                <Button Content="Войти в аккаунт Spotify"
                        Command="{x:Bind ViewModel.LoginCommand}"
                        IsEnabled="{x:Bind ViewModel.IsClientIdConfigured, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="24,8" Margin="0,8,0,0" />
                <HyperlinkButton Content="Изменить Client ID"
                                 Command="{x:Bind ViewModel.EditClientIdCommand}"
                                 Visibility="{x:Bind ViewModel.IsClientIdConfigured, Mode=OneWay}"
                                 HorizontalAlignment="Center" FontSize="12" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="24" Height="24" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </Grid>

        <!-- Экран 2: Авторизованная рабочая среда.
             Плейлисты добавляются в MenuItems из кода: MenuItems и MenuItemsSource нельзя использовать вместе. -->
        <NavigationView Grid.Row="2"
                        x:Name="NavView"
                        Visibility="{x:Bind ViewModel.IsAuthenticated, Mode=OneWay}"
                        PaneDisplayMode="Auto"
                        ExpandedModeThresholdWidth="1000"
                        CompactModeThresholdWidth="640"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="260"
                        SelectionChanged="NavView_SelectionChanged"
                        DisplayModeChanged="NavView_DisplayModeChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Главная" Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Поиск" Tag="Search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Любимые треки" Tag="Liked">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Моя медиатека" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Выйти" Tag="Logout" SelectsOnInvoked="False" Tapped="LogoutItem_Tapped">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF3B1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Свой пункт вместо встроенного: встроенный подписан "Settings" и не локализуется -->
                <NavigationViewItem Content="Настройки" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Основной контейнер страниц (HomeView, SearchView, PlaylistDetailView) -->
            <Frame x:Name="ContentFrame" Background="Transparent" Margin="0,0,12,0" />
        </NavigationView>

        <!-- Нижний бар воспроизведения -->
        <views:PlayerBarView Grid.Row="3"
                             DataContext="{x:Bind ViewModel.PlayerBar}"
                             Visibility="{x:Bind ViewModel.IsAuthenticated, Mode=OneWay}" />
    </Grid>
</win:FluentWindow>
